% %%% CONVERSION OF CHOICE RULES %%%
@choice {?h* : ?c*; ?rest[;:,]*} :- ?body*. ->
    $h  :- $c, $body, not $h'.
    $h' :- $c, $body, not $h.
    {$rest} :- $body. when $rest

@choice1 {?h* : ?c*} :- ?body*. ->
    $h  :- $c, $body, not $h'.
    $h' :- $c, $body, not $h.

@choice2 {?h* ; ?rest[;:,]*} :- ?body*. ->
    $h  :- $body, not $h'.
    $h' :- $body, not $h.
    {$rest} :- $body. when $rest

@choice3 {?h*} :- ?body*. ->
    $h  :- $body, not $h'.
    $h' :- $body, not $h.

